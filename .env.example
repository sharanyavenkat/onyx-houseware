# Authentication
# Admin login credentials (full access - can add, edit, delete)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Viewer login credentials (read-only access - can only view data)
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer123

# Session Configuration
# Secret key for session encryption (change this in production!)
SESSION_SECRET=onyx-houseware-secret-key-change-in-production

# Application Configuration
PORT=5001

# Node environment (development or production)
NODE_ENV=development

# Database URL
# Local - DATABASE_URL=server/data/onyx.db
# Prod - DATABASE_URL=/var/app/data/onyx.db
DATABASE_URL=database-url
